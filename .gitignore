# Backups a host makes of its own config and state. config.json holds the
# fleet token; a committed backup of it put the token in the history once.
*.bak
*.bak-*
config.json.*
state.json.*

# What the scout keeps at run time: the cells' start scripts and their JSON.
# A `git add -A` on a machine must not take them.
var/
